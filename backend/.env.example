# Google Cloud Vertex AI (Production Authentication via Application Default Credentials)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# Application Mode (production | demo | test)
APP_MODE=production

# Supabase PostgreSQL & RLS
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Integration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs
STRIPE_PRICE_FREE=price_free_id
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# Public Bid & Exchange Rate APIs
SAM_GOV_API_KEY=your_sam_gov_api_key
OPEN_EXCHANGE_RATES_APP_ID=your_open_exchange_rates_app_id
AWS_PRICING_API_URL=https://pricing.us-east-1.amazonaws.com

# Server & CORS
PORT=3001
FRONTEND_URL=http://localhost:8888

# Auth
JWT_SECRET=your_jwt_secret
